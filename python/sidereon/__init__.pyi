class Sp3WriteErrorDetail:
    """Typed payload attached to an `Sp3WriteError` as `.detail`.

    `kind` is the core variant name and `details()` that variant's own fields,
    keyed as `docs/sp3.md` lists them. The convenience properties return None
    for a variant that names no such field. A variant the binding does not name
    reports its core name as `kind` and its core `Debug` text under `"debug"`.
    """

    @property
    def kind(self) -> _Sp3WriteErrorKind: ...
    @property
    def message(self) -> str: ...
    @property
    def field(self) -> str | None: ...
    @property
    def epoch_index(self) -> int | None: ...
    @property
    def satellite(self) -> str | None: ...
    @property
    def columns(self) -> int | None: ...
    @property
    def decimals(self) -> int | None: ...
    def details(self) -> dict[str, Any]: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...

class PreciseEphemerisSample:
    """One precise-ephemeris sample: a satellite ECEF position (and optional
    clock) at one epoch, in SI units."""

    def __init__(
        self,
        satellite: str,
        epoch_j2000_seconds: float,
        position_ecef_m: Sequence[float] | npt.NDArray[np.float64],
        clock_s: float | None = ...,
        *,
        time_scale: TimeScale = ...,
        clock_event: bool = ...,
    ) -> None: ...
    @staticmethod
    def from_instant(
        satellite: str,
