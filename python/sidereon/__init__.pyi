class RinexClockParseError(ParseError):
    """Raised when a RINEX clock file fails strict parsing.

    `detail` carries the typed payload of the core refusal. A source that
    cannot be read or is not UTF-8 text fails before the core parser runs, and
    a hand-built instance has none, so the class attribute defaults to None.
    """

    detail: RinexClockErrorDetail | None

class RinexClockWriteError(SidereonError, ValueError):
    """Raised when a RINEX clock product cannot be written.

    A value no 19-column field states exactly, an epoch no seconds field states
    exactly under the write policy, or a time scale no RINEX clock time system
    names. `detail` carries the typed payload of the core refusal and is None
    on a hand-built instance.
    """

    detail: RinexClockErrorDetail | None

class RinexClockQueryError(RinexClockParseError, ValueError):
    """Raised when the core refuses a RINEX clock query.

    Subclasses RinexClockParseError, which `RinexClock.clock_s` raised before,
    and ValueError, which the instant and GPS-seconds queries raised before.
    `detail` carries the typed payload of the core refusal and is None on a
    hand-built instance.
    """

    detail: RinexClockErrorDetail | None

class RinexClockEditError(SidereonError, ValueError):
