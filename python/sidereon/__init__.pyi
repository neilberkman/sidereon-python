class RinexLintFinding:
    """One typed RINEX lint finding.

    `kind` is the core variant name and `details()` that variant's own payload
    under its own keys, typed as the union of the per-variant payloads above.
    `detail` is a debug rendering of the whole finding, for a log line; read
    `details()` to get the native values.

    `Finding` is `#[non_exhaustive]` in the core, so a variant a newer core adds
    reads as `kind == "Unknown"` with an empty payload until this binding maps
    it.
    """

    @property
    def kind(self) -> _RinexLintFindingKind: ...
    @property
    def code(self) -> str: ...
    @property
    def severity(self) -> RinexLintSeverity: ...
    @property
    def spec_ref(self) -> str: ...
    @property
    def at(self) -> RinexFindingRef: ...
    @property
    def is_repairable(self) -> bool: ...
    @property
    def detail(self) -> str: ...
    def details(self) -> _RinexLintFindingDetails: ...
    def __repr__(self) -> str: ...

