    @property
    def residuals_m(self) -> list[float]: ...
    @property
    def solution(self) -> SppSolution: ...
    @property
    def excluded(self) -> list[str]: ...
    @property
    def iterations(self) -> int:
        """Number of exclusions performed, `len(excluded)`."""
    @property
    def raim(self) -> RaimResult:
        """The detection test of the accepted solution."""
    def __repr__(self) -> str: ...

@overload
def raim(
    used_sats: RaimInput,
    residuals_m: None = ...,
    p_fa: float = ...,
    weights: _RaimWeightsArg | None = ...,
    n_systems: int | None = ...,
    variances_m2: None = ...,
) -> RaimResult: ...
@overload
def raim(
    used_sats: Sequence[str],
