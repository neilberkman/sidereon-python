    def header(self) -> Sp3Header: ...
    @property
    def comments(self) -> list[str]: ...
    @property
    def skipped_records(self) -> int: ...
    def prediction_summary(self) -> Sp3PredictionSummary: ...
    def to_sp3_string(self) -> str:
        """Serialize to SP3 text; raises `Sp3WriteError` rather than change a
        value to fit its columns."""
    def precise_ephemeris_samples(self) -> list[PreciseEphemerisSample]: ...
    def precise_ephemeris_accuracy_samples(
        self,
    ) -> list[PreciseEphemerisAccuracySample]: ...
    def precise_interpolant_artifact_bytes(
        self, gap_threshold_factor: float | None = ...
    ) -> bytes: ...
    def __repr__(self) -> str: ...

