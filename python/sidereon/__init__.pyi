    def satellite_coverage(self) -> Sp3Coverage: ...
    def interpolate(
        self, satellite: str, j2000_seconds: npt.NDArray[np.float64]
    ) -> Sp3Interpolation: ...
    def position_at_epoch_query(
        self, satellite: str, epoch: ExactEpochQuery
    ) -> Sp3State: ...
    def selected_state_at_epoch_query(
        self,
        satellite: str,
        epoch: ExactEpochQuery,
        selection_epoch: ExactEpochQuery,
    ) -> EphemerisQueryState | None: ...
    def transmit_epoch_clock_at_epoch_query(
        self, satellite: str, epoch: ExactEpochQuery, selection_epoch: ExactEpochQuery
    ) -> tuple[float, str | None] | None: ...
