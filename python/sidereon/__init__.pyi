# carries no keys at all.

class _FindingNoPayload(TypedDict):
    """`ObsMissingObsTypes`, `ObsEmptySatelliteRecord`, `ObsIntervalUnavailable`,
    `NavLeapSecondsAbsent`, `NavUnsortedRecords`, and any variant a newer core
    adds that this binding does not yet map (`kind` reads `"Unknown"`).
    """

class _FindingMessage(TypedDict):
    """`ObsFatalParse`, `ObsEventHeaderUnreadable`, `NavFatalParse` and
    `NavIonoMalformed`, each with the reader's own message.
    """

    message: str

