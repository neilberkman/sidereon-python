class Sp3ClockRecord:
    """A clock-only SP3 record: the missing-orbit sentinel beside a valid clock.

    `clock_us` and `clock_rate_raw` are the file's own units (microseconds and
    1e-4 microseconds per second), exactly as read. The velocity and rate come
    from the paired `V` record and are None where there is none or it holds the
    absence sentinel.
    """

    @property
    def clock_s(self) -> float: ...
    @property
    def clock_us(self) -> float: ...
    @property
    def velocity_m_s(self) -> npt.NDArray[np.float64] | None: ...
