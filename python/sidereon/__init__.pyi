class SidereonError(Exception):
    """Base class for every Sidereon domain failure."""

class InertialError(SidereonError, ValueError):
    """Inertial core refusal with its variant and invalid-input fields."""

    kind: str | None
    field: str | None
    reason: str | None
    details: dict[str, Any] | None

class TideEvaluationError(SidereonError, ValueError):
    """Station-tide core refusal with its typed variant fields."""

    kind: str | None
    details: dict[str, Any] | None

class PppCorrectionsError(SidereonError, ValueError):
    """PPP precompute refusal with typed variant, epoch, and detail fields."""

    kind: str | None
    epoch_index: int | None
    details: dict[str, Any] | None

class ParseError(SidereonError):
    """Base class for input-format parse failures (SP3, TLE, ...)."""

class Sp3ParseError(ParseError):
    """Raised when an SP3 precise-ephemeris product fails to parse."""

class Sp3WriteError(Sp3ParseError, ValueError):
    """Raised when `Sp3.to_sp3_string` cannot state a product in SP3 text.

    A value finer or wider than its fixed columns, a value that would read back
    as one of the format's absence sentinels, text that would not survive the
    reader's trim, an epoch no record restates exactly, or a header that
    disagrees with the records. Nothing is rounded, shifted or dropped to make
    the write succeed. `detail` carries the typed payload of the core refusal;
    a hand-built instance has none, so the class attribute defaults to None.
    """

    detail: Sp3WriteErrorDetail | None

class AntexParseError(ParseError):
    """Raised when an ANTEX antenna product fails to parse.

    `detail` carries the typed payload of a core parse refusal; an unreadable
    source, bytes that are not UTF-8 and a hand-built instance have none.
    `AntexWriteError`, a subclass, also sets `field` and `reason` from a core
    write refusal; both are None otherwise.
    """

    field: str | None
    reason: str | None
    detail: AntexErrorDetail | None

class AntexWriteError(AntexParseError, ValueError):
    """Raised when `Antex.to_antex_string` refuses a product it cannot write
    without loss.

    `detail` carries the typed payload of the core refusal, and `field` and
    `reason` the core's; all three are None on a hand-built instance.
    """

class AntexQueryError(SidereonError, ValueError):
    """Raised when the core refuses an ANTEX frequency, PCO or PCV lookup.

    An unknown label, a label whose sections differ, a zenith outside the grid,
    or an empty grid. `detail` carries the typed payload of the core refusal
    and is None on a hand-built instance.
    """

    detail: AntexErrorDetail | None

class TleParseError(ParseError):
    """Raised when a two-line element set fails to parse or initialize SGP4."""

class GeodesicError(ValueError):
    """Raised when WGS84 geodesic inputs are invalid."""

class ProjVgridshiftError(ValueError):
    """Base class for invalid PROJ vertical-grid lookup coordinates."""

class ProjVgridshiftNonFiniteCoordinateError(ProjVgridshiftError):
    """Raised when a PROJ vertical-grid latitude or longitude is not finite."""

class ProjVgridshiftCoordinateOutsideGridError(ProjVgridshiftError):
    """Raised when a PROJ vertical-grid coordinate is outside the grid extent."""

class GeofenceError(SidereonError):
    """Raised when geofence construction or evaluation fails."""

class SolveError(SidereonError):
    """Raised when a solve or propagation fails (non-convergence, SGP4 error
    code, or integration failure)."""

    detail: IonexEpochErrorDetail | dict[str, Any] | None

class SelectionUnsettledError(SolveError):
    """Raised when an SPP or static solve's satellite selection does not
    settle within 10 passes, as RTKLIB `estpos` fails an epoch after `MAXITR`
    iterations. `passes` is the number of passes run, and None on a hand-built
    instance."""

    passes: int | None

class QualityError(SidereonError, ValueError):
    """Core quality-control refusal; `kind` is its stable core variant name."""

    kind: (
        Literal[
            "invalid_elevation",
            "missing_cn0",
            "invalid_parameter",
            "invalid_reliability_parameter",
            "invalid_probability",
            "invalid_system_count",
            "invalid_dof",
            "invalid_weight",
            "invalid_residuals",
            "invalid_design",
            "singular_geometry",
            "missing_variances",
            "invalid_variance",
        ]
        | None
    )

class FdeFaultUnresolvedError(SolveError):
    """Raised when fault detection and exclusion stops with a fault still
    detected. `reason` is `"exclusion_budget_exhausted"` (the exclusion budget
    was spent) or `"no_admissible_exclusion"` (every leave-one-out re-solve
    failed, used fewer than five satellites, or left a residual RMS above the
    cap). `solution` is the last solution, which still fails the test;
    `excluded` the satellites excluded to reach it, in exclusion order; `raim`
    its detection test, with `fault_detected` True. All four are None on a
    hand-built instance."""

    reason: str | None
    solution: SppSolution | None
    excluded: list[str] | None
    raim: RaimResult | None

