        self, satellite: str, epoch: ExactEpochQuery, position_ecef_m: Sequence[float]
    ) -> ClockRelativity: ...
    def state(self, satellite: str, epoch_index: int) -> Sp3State: ...
    def clock_record(self, satellite: str, epoch_index: int) -> Sp3ClockRecord: ...
    def clock_records_at(self, epoch_index: int) -> dict[str, Sp3ClockRecord]: ...
