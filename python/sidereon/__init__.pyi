    def __repr__(self) -> str: ...

class RaimResult:
    """Result of a residual chi-square RAIM test."""

    @property
    def fault_detected(self) -> bool: ...
    @property
    def test_statistic(self) -> float:
        """`sum (r / sigma)^2` under the solution weighting, `sum w r^2` under
        unit or per-satellite weights."""
    @property
    def threshold(self) -> float | None: ...
    @property
    def dof(self) -> int: ...
    @property
    def testable(self) -> bool: ...
    @property
    def normalized_residuals(self) -> dict[str, float]:
        """Weighted residuals (`r / sigma` or `r sqrt(w)`), not standardized by
        each residual's redundancy."""
    @property
    def worst_sat(self) -> str | None:
        """Largest absolute weighted residual; not a fault identification."""
    @property
    def rms_m(self) -> float: ...
    @property
    def reduced_chi_square(self) -> float | None: ...
    def __repr__(self) -> str: ...

class FdeResult:
    """Result of a fault-detection-and-exclusion loop."""

    @property
    def position(self) -> npt.NDArray[np.float64]: ...
    @property
    def rx_clock_s(self) -> float: ...
    @property
    def geodetic(self) -> tuple[float, float, float] | None: ...
    @property
