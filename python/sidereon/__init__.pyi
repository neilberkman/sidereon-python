# A RAIM `weights` argument: a `RaimWeights`, the label of its solution or unit
# mode, or per-satellite inverse-variance weights. `None` is the solution mode.
_RaimWeightsArg = RaimWeights | Literal["solution", "unit"] | Mapping[str, float]

class RaimInput:
    """Typed input for standalone residual chi-square RAIM. `variances_m2` are
    the variances (square metres) the estimator weighted each residual by, in
    residual order; the default solution weighting reads them."""

    def __init__(
        self,
        used_sats: Sequence[str],
        residuals_m: Sequence[float],
        variances_m2: Sequence[float] | None = ...,
    ) -> None: ...
