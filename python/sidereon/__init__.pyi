# `CodeListNotStated`, `CodeListsNotUnion` and `DeclaredListNotStated` each name
# only the constellation.
_ObsWriteCodeListNotStated = _ObsWriteSystemOnly
_ObsWriteCodeListsNotUnion = _ObsWriteSystemOnly
_ObsWriteDeclaredListNotStated = _ObsWriteSystemOnly

class _ObsWriteEpochFlagTooWide(TypedDict):
