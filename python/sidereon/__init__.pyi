# --- `ObsDowngradeChange.details()` payloads ---------------------------------
#
# One TypedDict per `kind`, with that variant's own keys and the native value
# types the binding puts in the dict. These are stub-only helper types: the
# runtime returns a plain `dict`, and no class under these names exists in the
# extension module. Import one under `typing.TYPE_CHECKING` to `cast` a payload
# after testing `kind`; mypy does not narrow a TypedDict union on `in`.

class _ObsDowngradeCodeRenamed(TypedDict):
    system: GnssSystem
    from_code: str
    to_code: str

class _ObsDowngradeCodeMoved(TypedDict):
    system: GnssSystem
    code: str
    from_position: int
    to_position: int

class _ObsDowngradeCodeAdded(TypedDict):
    system: GnssSystem
    code: str

class _ObsDowngradeCodeListRemoved(TypedDict):
    system: GnssSystem
    codes: list[str]

class _ObsDowngradeValueRounded(TypedDict):
    epoch_index: int
    satellite: str
    code: str
    from_value: float
    to_value: float

# `CycleSlipRounded` carries the same keys, for a slip rather than a value.
_ObsDowngradeCycleSlipRounded = _ObsDowngradeValueRounded

class _ObsDowngradeScaleFactorsRemoved(TypedDict):
    count: int

class _ObsDowngradeEpochPicosecondsRemoved(TypedDict):
    epoch_index: int
    picoseconds: int

class _ObsDowngradeClockOffsetRounded(TypedDict):
    epoch_index: int
    from_offset_s: float
    to_offset_s: float

class _ObsDowngradeInEventLists(TypedDict):
    epoch_index: int
    change: ObsDowngradeChange

class _ObsDowngradeDeprecatedRecordsRemoved(TypedDict):
    label: str
    epoch_index: int | None
    records: list[str]

class _ObsDowngradeEventRecordsRewritten(TypedDict):
    epoch_index: int
    from_records: list[str]
    to_records: list[str]

_ObsDowngradeChangeDetails = (
    _ObsDowngradeCodeRenamed
    | _ObsDowngradeCodeMoved
    | _ObsDowngradeCodeAdded
    | _ObsDowngradeCodeListRemoved
    | _ObsDowngradeValueRounded
    | _ObsDowngradeScaleFactorsRemoved
    | _ObsDowngradeEpochPicosecondsRemoved
    | _ObsDowngradeClockOffsetRounded
    | _ObsDowngradeInEventLists
    | _ObsDowngradeDeprecatedRecordsRemoved
    | _ObsDowngradeEventRecordsRewritten
)

_ObsDowngradeKind = Literal[
    "CodeRenamed",
    "CodeMoved",
    "CodeAdded",
    "CodeListRemoved",
    "ValueRounded",
    "CycleSlipRounded",
    "ScaleFactorsRemoved",
    "EpochPicosecondsRemoved",
    "ClockOffsetRounded",
    "InEventLists",
    "DeprecatedRecordsRemoved",
    "EventRecordsRewritten",
]

# --- `RinexObsWriteErrorDetail.details()` payloads ---------------------------
#
# One TypedDict per `kind`, as for `ObsDowngradeChange` above, and stub-only in
# the same way. `code` is `str | None` where the core field is optional.

class _ObsWriteCodeListsNotVersionTwo(TypedDict):
